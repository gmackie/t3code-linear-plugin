{
  "schemaVersion": 2,
  "id": "com.t3code.kanbanger",
  "displayName": "Kanbanger",
  "version": "0.3.0",
  "description": "Kanbanger issues and work graph for agents, and a board of your issues.",
  "mcpServer": {
    "name": "kanbanger",
    "transport": {
      "type": "http",
      "url": "https://tasks.gmac.io/mcp",
      "headers": [],
      "auth": {
        "type": "oauth",
        "scopes": ["mcp:read", "mcp:write"]
      }
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "board",
        "title": "My issues",
        "scope": "project",
        "resourceUri": "ui://kanbanger/board"
      }
    ],
    "commands": [
      {
        "id": "open-board",
        "title": "Kanbanger: Open my issues",
        "panel": "board"
      }
    ]
  },
  "t3Tools": []
}
