{
  "schemaVersion": 2,
  "id": "com.t3code.kanbanger",
  "displayName": "Kanbanger",
  "version": "0.4.1",
  "description": "Kanbanger issues, planning specs and work graph for agents, with panels for your issues and planning specs.",
  "mcpServer": {
    "name": "kanbanger",
    "transport": {
      "type": "http",
      "url": "https://tasks.gmac.io/mcp",
      "headers": [],
      "auth": {
        "type": "oauth",
        "scopes": ["mcp:read", "mcp:write"]
      }
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "board",
        "title": "My issues",
        "scope": "project",
        "resourceUri": "ui://kanbanger/board",
        "issuesTab": true
      },
      {
        "id": "specs",
        "title": "Planning specs",
        "scope": "project",
        "resourceUri": "ui://kanbanger/specs",
        "issuesTab": true
      }
    ],
    "commands": [
      {
        "id": "open-board",
        "title": "Kanbanger: Open my issues",
        "panel": "board"
      },
      {
        "id": "open-specs",
        "title": "Kanbanger: Open planning specs",
        "panel": "specs"
      }
    ]
  },
  "t3Tools": []
}
