{
  "schemaVersion": 2,
  "id": "com.t3code.linear",
  "displayName": "Linear",
  "version": "0.2.0",
  "description": "Linear and Linear-compatible (Kanbanger) issues for agents and panels.",
  "mcpServer": {
    "name": "linear",
    "transport": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "${pluginRoot}/src/mcp.ts"
      ],
      "env": [
        {
          "name": "LINEAR_API_URL",
          "value": "https://api.linear.app/graphql",
          "title": "Linear-compatible GraphQL endpoint",
          "description": "Linear, or a compatible endpoint such as https://tasks.gmac.io/graphql."
        },
        {
          "name": "LINEAR_API_TOKEN",
          "value": "",
          "sensitive": true,
          "title": "API key",
          "description": "A Linear personal API key, Linear OAuth token, or Kanbanger API key."
        },
        {
          "name": "LINEAR_POLL_SECONDS",
          "value": "60",
          "title": "Refresh interval in seconds (15-3600)"
        }
      ]
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "linear-issues",
        "title": "Linear issues",
        "scope": "project",
        "resourceUri": "ui://linear/issues.html",
        "tool": {
          "name": "linear_issues",
          "arguments": {}
        }
      }
    ],
    "commands": [
      {
        "id": "linear-open-issues",
        "title": "Linear: Open issues",
        "panel": "linear-issues"
      }
    ]
  },
  "t3Tools": []
}
